p
  - if @user.to_s.present?
    = t('devise.emails.reminder.greetings.named', name: @user.to_s)
  - else
    = t('devise.emails.reminder.greetings.anon')

p = t('devise.emails.reminder.body', title: @event.title, date: l(@event.started_at, format: :date_time_full), place: @event.place)

p = link_to t('devise.emails.reminder.event_link'), event_url(@event)

'--
br
== t('devise.emails.signature')
