nav.navbar-footer
  .container
    .mdc-layout-grid
      .mdc-layout-grid__inner
        .footer-cell
          = link_to "2014&thinsp;—&thinsp;#{Date.today.year} © IT52.info".html_safe, root_path

          .social-icons
            a.mdc-icon-button href='https://play.google.com/store/apps/details?id=io.github.defolters.it52&utm_source=it52' target='_blank' title="Google Play" = icon 'fab', 'google-play', class: 'fa-xs'
            a.mdc-icon-button href='https://github.com/NNRUG/it52-rails' target='_blank' title="Github" = icon 'fab', 'github', class: 'fa-xs'
            a.mdc-icon-button href='https://hub.docker.com/r/it52/rails' target='_blank' title="DockerHub" = icon 'fab', 'docker', class: 'fa-xs'
            a.mdc-icon-button href='https://vk.com/it52info' target='_blank' title="Вконтакте" = icon 'fab', 'vk', class: 'fa-xs'
            a.mdc-icon-button href='mailto:events@it52.info' target='_blank' title="E-mail" = icon 'fas', 'envelope', class: 'fa-xs'
            a.mdc-icon-button href='https://t.me/it52info' target='_blank' title="Telegram" = icon 'fab', 'telegram-plane', class: 'fa-xs'
        .footer-cell
          = link_to 'https://itgorky.ru/', class: 'mcs-logo' do
            = image_tag 'itgorky-logo.svg', alt: 'ITGorky: IT-карта Нижнего Новгорода'
            small IT-карта Нижнего Новгорода

