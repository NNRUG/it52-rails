- content_for :dynamic_javascripts
  = javascript_pack_tag 'editor', 'data-turbolinks-track': true, defer: true

.page-header
  h1 = t('.title')

= simple_form_for @user, url: my_profile_path do |f|
  .row
    .col-sm-3
      - if @user.avatar_image.present?
        .title-image
          .avatar = image_tag @user.avatar_image.square_150.url

      = f.input :avatar_image, wrapper: :vertical_file_input
      = f.input :avatar_image_cache, as: :hidden

    .col-sm-7.col-sm-offset-1
      = f.input :first_name
      = f.input :last_name
      = f.input :nickname
      = f.input :employment
      = f.input :website

      = f.input :bio, input_html: { rows: 7, class: 'mde-textarea' }

      - if current_user.email.present?
        = f.input :subscription, wrapper: :vertical_boolean
      - else
        = f.input :subscription, wrapper: :vertical_boolean, disabled: true, hint: false
        .alert.alert-warning
          p
            'Пожалуйста,
            a.alert-link href=edit_user_registration_path укажите вашу почту
            |, чтобы подписаться на уведомления.

      .event-categories-block.form-group class=('has-error' if @user.errors[:interested_category_ids].any?)
        label.control-label = t('.interested_categories_label')
        - if @user.errors[:interested_category_ids].any?
          span.help-block = @user.errors.full_messages_for(:interested_category_ids).first
        .event-categories-inner
          .row
            - categories = Category.order(:name).to_a
            - column_count = 4
            - selected_ids = @user.interested_category_ids.presence || Category.pluck(:id)
            - categories.each_slice((categories.size.to_f / column_count).ceil) do |column_categories|
              .col-xs-6.col-md-3
                - column_categories.each do |category|
                  .checkbox
                    label
                      = check_box_tag 'user[interested_category_ids][]', category.id, selected_ids.include?(category.id), id: "user_interested_category_ids_#{category.id}"
                      = category.name

      = f.submit class: 'btn btn-primary'
      ' &nbsp;
      = link_to t(:cancel), my_profile_path, class: 'btn btn-default'

