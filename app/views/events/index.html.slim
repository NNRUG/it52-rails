- content_for(:head) do
  link rel="canonical" href=root_path

- content_for(:topbar_actions) do
  - if user_signed_in? && !unapproved_count.zero?
    a.mdc-chip.unapproved-chip href=events_path(status: 'unapproved') title='На модерации'
      i.material-icons.mdc-chip__icon.mdc-chip__icon--leading warning
      .mdc-chip__text = "(#{unapproved_count})"

  a.material-icons.mdc-top-app-bar__action-item href=new_event_path title='Добавить событие' add

.welcome-block
  .welcome-block__text
    h2.welcome-block__title = t('.welcome_title')
    p.welcome-block__paragraph = t('.welcome_text')
    p.welcome-block__paragraph
      = t('.welcome_text_subscribe')
      = link_to 'IT52', t('.welcome_telegram_link'), target: '_blank', rel: 'noopener noreferrer', class: 'welcome-block__link'
  .welcome-block__buttons
    = link_to t('.welcome_add_event'), new_event_path, class: 'mdc-button mdc-button--raised'
    = link_to t('.welcome_it_map'), 'https://itgorky.ru/', target: '_blank', rel: 'noopener noreferrer', class: 'mdc-button mdc-button--outlined'
    = link_to t('.welcome_developed'), 'https://itgorky.ru/made-in-nn', target: '_blank', rel: 'noopener noreferrer', class: 'mdc-button mdc-button--outlined'
    = link_to t('.welcome_vacancies'), 'https://t.me/jobsit52', target: '_blank', rel: 'noopener noreferrer', class: 'mdc-button mdc-button--outlined'
    = link_to t('.welcome_telegram_channel'), 'https://t.me/it52info', target: '_blank', rel: 'noopener noreferrer', class: 'mdc-button mdc-button--outlined'
    = link_to t('.welcome_flood'), 'https://t.me/nn_rug', target: '_blank', rel: 'noopener noreferrer', class: 'mdc-button mdc-button--outlined'

.events-select-menu-wrapper
  #events-select-menu.events-select-menu.mdc-select.mdc-menu-surface--anchor
    input type="hidden" name="enhanced-select" role="button" aria-haspopup="listbox"
    i.mdc-select__dropdown-icon
    .mdc-select__selected-text aria-haspopup="true"
    #events-select-menu-list.mdc-select__menu.mdc-menu.mdc-menu-surface
      ul.mdc-list
        - if filter_params[:status] == 'unapproved'
          li.mdc-list-item.mdc-list-item--selected role="option" data-value='unapproved' data-url=root_path(filter_params.merge(status: 'unapproved')) aria-selected="true" = "На модерации (#{unapproved_count})"
        - else
          - Event.sorted_kind_filter_options.each do |key, title|
            li.mdc-list-item class=('mdc-list-item--selected' if current_filter?(key)) role="option" data-value=key data-url=root_path(filter_params.merge(kind: key)) aria-selected=(current_filter?(key) ? "true" : false)
              = filter_params[:tag] ? "#{title} с тэгом #{filter_params[:tag]}" : title
    / span.mdc-floating-label Select something
    / .mdc-line-ripple

.events-index
  - if @events.present? && filter_params[:status] != 'unapproved'
    .page-header
      .pull-right
        .feed-icons
          a.mdc-icon-button href=events_path(format: :ics) title='Добавить в календарь'
            i.material-icons.mdc-icon-button__icon aria-hidden="true" event_note
          a.mdc-icon-button href=events_path(format: :atom) title='RSS'
            i.material-icons.mdc-icon-button__icon aria-hidden="true" rss_feed

      nav.events-nav
        a.mdc-button class=('mdc-button--outlined' if filter_params[:status].nil? || filter_params[:status] == 'future') href=events_path(filter_params.merge(status: 'future'))
          span.mdc-button__label = t('.future_events')
        a.mdc-button class=('mdc-button--outlined' unless filter_params[:status].nil? || filter_params[:status] == 'future') href=events_path(filter_params.merge(status: 'past'))
          span.mdc-button__label = t('.past_events')

  - if @events.empty?
    .alert.alert-success
      p Похоже все коллеги устали митапить и хакатонить и сейчас отдыхают.
      p
        'Но вы всегда можете встряхнуть их,
        = link_to 'организовав новую встречу', new_event_path, class: 'alert-link'
        |.
      hr
      p: small
        = mail_to 'events@it52.info', 'Напишите нам', class: 'alert-link'
        ', если хотите, но не знаете как. Мы всегда поможем с организацией. Бесплатно.
  - else
    .events
      = render @events, cached: true

  // pagination
  .text-center
    == paginate @events.object
