script type="application/ld+json" == @structured_data.to_json

.title-image-wrapper style="background-image: url(#{image_url(@event.title_image.fb_1200.url)})"
  .event-page-header
    h2
      = @event.local_started_at
      div = @event.human_time_distance

    h1.event-header
      span.event-kind
        | [#{t("activerecord.attributes.event.kinds.#{@event.kind}")}]
      span.event-header-separator< 
      = @event.title
    h3
      = @event.place
      - if @event.address_comment.present?
        div = @event.address_comment

- if can?(:edit, @event.object) || can?(:publish, @event.object) || current_user&.admin?
  .row: .col-xs-12
    .pull-right
      - if can? :edit, @event.object
        = link_to t(:edit), edit_event_path(@event), class: 'btn btn-default'
        | &nbsp;
      - if can? :publish, @event.object
        - if !@event.published?
          = link_to t('.publish'), publish_event_path(@event), class: 'btn btn-warning', method: :patch
        - else
          = link_to t('.cancel_publication'), cancel_publication_event_path(@event), class: 'btn btn-warning', method: :patch
      - if current_user&.admin?
        | &nbsp;
        = link_to t('.delete'), event_path(@event), class: 'btn btn-danger', method: :delete, data: { confirm: t('.delete_confirm') }

.events-show.event data={ id: @event.id }
  .row
    .col-xs-12.col-sm-5
      - if @event.address.present?
        #event-map.event-map data={ lat: @event.address.lat, long: @event.address.long, title: @event.title }

    .col-xs-12.col-sm-7
      .event-date: p title="Время проведения"
        i.fas.fa-fw.fa-calendar>
        = link_to @event.local_started_at, event_path(@event, format: :ics)
      - if @event.place.present?
        .event-place: p title="Место проведения"
          i.fas.fa-fw.fa-map-marker>
          = @event.link_to_place
      - if @event.online_broadcast.present?
        .event-online-broadcast: p title="Онлайн трансляция"
          i.fas.fa-fw.fa-video>
          = link_to t('activerecord.attributes.event.online_broadcast'), @event.online_broadcast, target: '_blank', rel: 'noopener noreferrer'
      - if @event.respond_to?(:telegram_channel) && @event.telegram_channel.present?
        .event-telegram-channel: p title="Telegram канал или группа"
          i.fab.fa-fw.fa-telegram>
          = link_to @event.telegram_channel, @event.telegram_channel_url, target: '_blank', rel: 'noopener noreferrer'
      .event-organizer: p title="Организатор"
        i.fas.fa-fw.fa-user>
        span> Организатор:
        a href=user_path(@event.organizer)
          span = @event.organizer
      .event-participants: p title="Участники"
        i.fas.fa-fw.fa-users>
        span = "Участники: #{@event.participants.size}"
      - if @event.tag_list.present?
        .event-tags: p title="Тэги"
            i.fas.fa-fw.fa-tag>
            == @event.tag_list.map { |tag| link_to "##{tag}", tag_path(tag)}.join(', ')
      - if @event.categories.any?
        .event-categories: p title="Категории"
          i.fas.fa-fw.fa-folder>
          = @event.categories.map(&:name).join(', ')
      .event-share: p title="Поделиться"
        i.fas.fa-fw.fa-share-alt>
        span> Поделиться в
        span.ya-share2< data={ counter: true, lang: "ru", services: "telegram,vkontakte,facebook,twitter,gplus", size: 'm', title: @event.title, description: @event.truncated_description, url: event_url(@event)}
      .event-views: p title="Просмотры"
        i.fas.fa-fw.fa-eye>
        span.event-views-counter data={ 'event-path' => event_path(@event) } = @event.pageviews


      = render partial: 'participate_block', object: @event, as: :event
  hr
  - if (@event.paid? && @event.price.present?) || (@event.registration_limit_enabled? && @event.participants_limit.present?) || @event.online_broadcast.present? || (@event.respond_to?(:telegram_channel) && @event.telegram_channel.present?)
    .event-broadcast-actions
      .event-price-and-limit
        - if @event.paid? && @event.price.present?
          .event-price-info
            i.fas.fa-fw.fa-money-bill.event-price-icon
            span.event-price-label = t('.participation_price_label')
            span = t('.participation_price_value', price: @event.price)
        - if @event.registration_limit_enabled? && @event.participants_limit.present?
          .event-participants-limit-info
            i.fas.fa-fw.fa-users.event-participants-limit-icon
            span.event-participants-limit-label = t('.participants_limit_label')
            span = t('.participants_limit_value', count: @event.participants_limit)
      - if @event.online_broadcast.present?
        = link_to @event.online_broadcast, class: 'btn btn-primary', target: '_blank', rel: 'noopener noreferrer' do
          i.fas.fa-fw.fa-video
          span = t('.watch_broadcast')
      - if @event.respond_to?(:telegram_channel) && @event.telegram_channel.present?
        = link_to @event.telegram_channel_url, class: 'btn btn-default', target: '_blank', rel: 'noopener noreferrer' do
          i.fab.fa-fw.fa-telegram
          span = t('.telegram_channel_btn')
  .event-description = @event.rendered_description


  .participants
    .panel.panel-default
      .panel-heading.clearfix
        h4.pull-left
          => Event.human_attribute_name(:participants)
          small
            = @event.participants.size
            - if @event.registration_limit_enabled? && @event.participants_limit.present?
              = " | #{@event.participants_limit}"
        .pull-right
          - if can? :download_participants, @event.object
            = link_to t('.participants_export'), participants_event_path(@event, format: :csv), class: 'btn btn-warning'
      .panel-body
        = render partial: 'participants_block', object: @event, as: :event
      .panel-footer
        = render partial: 'participate_block', object: @event, as: :event
